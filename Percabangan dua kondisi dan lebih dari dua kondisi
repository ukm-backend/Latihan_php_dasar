1. Dua Kondisi ( if - else )

if ( kondisi ) {
    // di jalankan jika kondisi TRUE 
}else {
    // dijalankan jika kondisi FALSE 
}



2. Lebih dari Dua Kondisi ( if - elseif - else ) 

if ( kondisi_1 ) {
     // di jalankan jika kondisi_1 TRUE
}elseif ( kondisi_2 ) {
     // di jalankan jika kondisi_2 TRUE 
} else {
     // di jalankan jika SEMUA kondisi di atas FALSE 
}

